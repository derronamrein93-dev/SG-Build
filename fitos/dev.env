# Local development values. NOT SECRETS — they are in the repository on purpose,
# so `bash db/reset.sh` and `npm run test` produce identical hashes and the
# seeded demo customer stays findable by phone.
#
# They exist because the application refuses to invent a pepper for you. That is
# the point: a missing pepper is a loud failure, never a silent default.
#
# Never use these anywhere real. A production pepper comes from the deployment
# environment and never from a file in git:  openssl rand -base64 48
#
# Sourced by db/reset.sh and by the `test` script in package.json. Values
# already present in the environment win, so exporting your own overrides these.

: "${FITOS_ORG_HASH_SECRET:=dev-local-org-pepper-not-for-production-0001}"
: "${FITOS_IDENTITY_SECRET:=dev-local-identity-pepper-not-for-production-01}"
# Only PGPASSWORD, deliberately. Exporting PGDATABASE here would make the
# superuser session in db/reset.sh connect to `fitos` and then fail to drop it;
# the remaining PG* variables have working defaults in src/lib/db/client.ts and
# are documented in .env.example.
: "${PGPASSWORD:=fitos}"

export FITOS_ORG_HASH_SECRET FITOS_IDENTITY_SECRET PGPASSWORD
