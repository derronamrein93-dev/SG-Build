{
  "name": "fitos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ". ./dev.env && next dev -p 3000",
    "build": "next build",
    "start": ". ./dev.env && next start -p 3000",
    "test": ". ./dev.env && tsx --test $(find src -name '*.test.ts' | sort)",
    "db:reset": "bash db/reset.sh",
    "db:isolation": "psql -h 127.0.0.1 -U fitos_owner -d fitos -q -v ON_ERROR_STOP=1 -f db/test/isolation.sql",
    "db:preflight": "psql -h 127.0.0.1 -U fitos_owner -d fitos -q -v ON_ERROR_STOP=1 -c \"set role fitos_svc\" -c 'select * from report_view_orphan_audit()'",
    "db:preflight-test": "psql -h 127.0.0.1 -U fitos_owner -d fitos -q -v ON_ERROR_STOP=1 -f db/test/preflight.sql",
    "verify": "bash db/reset.sh && npm run test && npm run db:preflight-test && npm run db:isolation && npm run deploy:check && npm run build && npm run kiosk:compat && bash db/reset.sh",
    "demo": "bash db/reset.sh && npm run build && npm start",
    "e2e": "node e2e/golden-paths.mjs",
    "e2e:full": "bash db/reset.sh && npm run build && (npm start & echo $! > /tmp/fitos-e2e.pid) && node e2e/wait-for-server.mjs && node e2e/golden-paths.mjs; s=$?; kill $(cat /tmp/fitos-e2e.pid) 2>/dev/null; exit $s",
    "deploy:bundle": "bash deploy/build-bundle.sh",
    "deploy:check": "bash deploy/check-bundle.sh",
    "kiosk:compat": "npx tsx scripts/legacy-scan.ts public/kiosk .next/static/chunks",
    "kiosk:icons": "node scripts/make-icons.mjs",
    "kiosk:enroll": ". ./dev.env && npx tsx scripts/kiosk-admin.ts",
    "kiosk:sim": ". ./dev.env && npx tsx scripts/sg-sim.ts",
    "kiosk:e2e": "node e2e/kiosk-viewport.mjs"
  },
  "dependencies": {
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "autoprefixer": "^10.5.4",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "chrome 64",
    "edge 79",
    "firefox 67",
    "opera 51",
    "safari 12",
    "ios_saf 12.2"
  ]
}
